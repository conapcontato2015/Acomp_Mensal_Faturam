# Copie para .env e ajuste. O iniciar.bat faz a cópia na primeira execução.

# Troque por um texto longo e aleatório (protege o cookie de sessão)
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# Banco: vazio = SQLite em dados/faturamento.db (uso local)
# Servidor: DATABASE_URL=postgresql://usuario:senha@servidor:5432/conap
DATABASE_URL=

# Pasta dos dados locais (banco SQLite, backups, prévias de importação)
# DADOS_DIR=C:\Faturamento\dados

# local = janela "Quem está usando?"; plataforma = usuário vem do login do Conap Ferramentas (JWT)
MODO_AUTH=local
# Modo plataforma: o JWT da plataforma (cookie JWT_COOKIE ou "Authorization: Bearer").
# HS256 usa o mesmo segredo do FastAPI da plataforma; RS256 usa a chave pública (JWT_CHAVE_PUBLICA).
# JWT_COOKIE=token
# JWT_ALGORITMO=HS256
# JWT_SEGREDO=
# JWT_CAMPO_ID=sub
# JWT_CAMPO_NOME=nome
# Sem JWT configurado, o usuário pode vir de um cabeçalho posto por um proxy de login:
AUTH_HEADER=X-Remote-User

# Prefixo quando rodar dentro de outra aplicação, ex.: /faturamento
URL_PREFIX=

# 127.0.0.1 = só este PC; 0.0.0.0 = rede do escritório (use iniciar_rede.bat)
HOST=127.0.0.1
PORT=5000

# Cópias diárias do banco guardadas em dados/backups
BACKUP_DIAS=30

# Fuso horário do escritório (datas, horas e virada de mês). Padrão: Fortaleza-CE.
# FUSO_HORARIO=America/Fortaleza

# Alerta no painel quando as saídas variam mais que isto (0.5 = 50%) contra a média dos 3 meses anteriores
LIMITE_VARIACAO=0.5

# Fonte dos responsáveis: manual (padrão), controle_fiscal ou api (quando o sistema externo for ligado)
RESPONSAVEIS_PROVEDOR=manual
RESPONSAVEIS_API_URL=
RESPONSAVEIS_API_TOKEN=

# Controle Fiscal (outro sistema da CONAP, no mesmo PC): de lá vêm responsável, CNPJ e código das empresas.
# O banco dele é só LIDO (sessão em modo somente leitura). Vazio = integração desligada.
# Use o mesmo usuário/senha/banco do .env do Controle Fiscal:
# FOLHA_DATABASE_URL=postgresql://usuario:senha@localhost:5432/controle_fiscal
FOLHA_DATABASE_URL=
# Nomes de responsável diferentes entre os sistemas (NomeLá=NomeAqui, separados por ;)
# FOLHA_MAPA_RESPONSAVEIS=Natan Lima=Natan;Jaisa Souza=Jaísa
FOLHA_MAPA_RESPONSAVEIS=

# Cruzamento Domínio × SEFAZ (online, no Manus): números do mês por empresa. Só leitura. Vazio = desligado.
# A chave é a mesma FATURAMENTO_API_KEY cadastrada nos segredos do Manus.
# CRUZAMENTO_URL=https://endereço-do-cruzamento
CRUZAMENTO_URL=
CRUZAMENTO_API_KEY=
# Tempo máximo de espera da resposta, em segundos
CRUZAMENTO_TIMEOUT=90

# Cadastro de empresas: local (cadastrado aqui, padrão) ou plataforma (cadastro geral do Conap Ferramentas,
# só leitura). Com "plataforma", nome/CNPJ/situação vêm de lá; aqui ficam tipos usados e responsável.
EMPRESAS_FONTE=local
# PLATAFORMA_DATABASE_URL=postgresql://usuario:senha@servidor:5432/conap
# PLATAFORMA_EMPRESAS_TABELA=empresas
# Colunas que diferem do padrão (id, nome, cnpj, ativa), no formato campo=coluna;...
# PLATAFORMA_EMPRESAS_COLUNAS=nome=razao_social;ativa=ativo
